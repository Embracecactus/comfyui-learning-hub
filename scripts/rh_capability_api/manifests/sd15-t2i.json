{
  "capability": "sd15-t2i",
  "title": "SD1.5 文生图（最小计费样本/冒烟）",
  "output": "image",
  "workflowInline": {
    "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "v1-5-pruned-emaonly.safetensors"}, "_meta": {"title": "Load SD1.5"}},
    "5": {"class_type": "EmptyLatentImage", "inputs": {"width": 512, "height": 512, "batch_size": 1}, "_meta": {"title": "Latent"}},
    "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}, "_meta": {"title": "positive"}},
    "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "blurry, low quality, watermark", "clip": ["4", 1]}, "_meta": {"title": "negative"}},
    "3": {"class_type": "KSampler", "inputs": {"seed": 42, "steps": 20, "cfg": 8.0, "sampler_name": "euler", "scheduler": "normal", "denoise": 1.0, "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]}, "_meta": {"title": "KSampler"}},
    "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}, "_meta": {"title": "VAE Decode"}},
    "9": {"class_type": "SaveImage", "inputs": {"images": ["8", 0], "filename_prefix": "rh-cap-sd15"}, "_meta": {"title": "Save"}}
  },
  "outputNodes": ["9"],
  "params": {
    "prompt": {"node": "6", "field": "text", "type": "string", "required": true},
    "negativePrompt": {"node": "7", "field": "text", "type": "string", "default": "blurry, low quality, watermark"},
    "width": {"node": "5", "field": "width", "type": "number", "default": 512},
    "height": {"node": "5", "field": "height", "type": "number", "default": 512},
    "steps": {"node": "3", "field": "steps", "type": "number", "default": 20}
  }
}
